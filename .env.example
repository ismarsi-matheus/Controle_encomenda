# Usuários que podem entrar no sistema: usuario:senha, separados por vírgula
USUARIOS=maria:troque-esta-senha,joao:outra-senha-forte

# Opcional: segredo para assinar o login. Se não existir, o sistema usa a própria lista de USUARIOS.
# SESSAO_SEGREDO=uma-frase-longa-e-aleatoria

# Criadas automaticamente quando você conecta o Upstash Redis no projeto da Vercel:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
